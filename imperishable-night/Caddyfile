{
	log default {
		output stdout
		format json
		include http.log.access tls
	}

	metrics

	servers {
		trusted_proxies static private_ranges @trusted_proxies@
		trusted_proxies_strict
	}

	tailscale {
		auth_key {env.TS_AUTHKEY}
		state_dir /data/tailscale
	}

	# The image has no certutil, and nothing in the container needs to trust the root.
	skip_install_trust

	# lotus-land-story's root, so devices that trust it trust these sites too.
	pki {
		ca local {
			root {
				format pem_file
				cert /etc/caddy/pki/root.crt
				key /etc/caddy/pki/root.key
			}
		}
	}
}

# Tailnet-bound sites: internal TLS, a dedicated tailscale node, and access
# logging routed to the default logger.
(ts) {
	tls internal
	bind tailscale/{args[0]}
	log
}

books {
	import ts books
	tailscale_auth
	reverse_proxy calibre-web:8083 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}
}

homebox {
	import ts homebox
	reverse_proxy homebox:7745
}

docs {
	import ts docs
	tailscale_auth
	reverse_proxy paperless-ngx:8000 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}

	redir /flower /flower/
	handle /flower/* {
		reverse_proxy paperless-ngx:5555
	}
}

irc {
	import ts irc
	tailscale_auth

	root * /srv/gamja
	file_server
	reverse_proxy /socket soju:3030
}

ketchup {
	import ts ketchup
	tailscale_auth
	reverse_proxy ketchup:9292 {
		header_up Tailscale-User-Login {http.auth.user.tailscale_login}
		header_up Tailscale-User-Name {http.auth.user.tailscale_user}
	}
}

quire {
	import ts quire
	tailscale_auth
	reverse_proxy quire:3000 {
		header_up Remote-User {http.auth.user.tailscale_login}
	}
}

rss {
	import ts rss

	# Outside tailscale_auth, which rejects tagged nodes like lotus-land-story's scraper.
	handle /metrics {
		reverse_proxy miniflux:8080 {
			header_up -Remote-User
		}
	}

	handle {
		tailscale_auth
		reverse_proxy miniflux:8080 {
			header_up Remote-User {http.auth.user.tailscale_login}
		}
	}
}

### Public

quire.kejadlen.dev {
	# quire trusts Remote-User as proof of login.
	reverse_proxy quire:3000 {
		header_up -Remote-User
	}
}

git.kejadlen.dev {
	log

	# Maps gitea's URLs onto quire's. quire only shows the default branch,
	# so links to other branches, tags, and commits land on its tip.
	route {
		@file path_regexp file ^/alpha/([^/]+)/(src|raw)/(branch|tag|commit)/[^/]+/(.+)$
		redir @file https://quire.kejadlen.dev/{re.file.1}/tree/{re.file.4} permanent

		@commit path_regexp commit ^/alpha/([^/]+)/commit/([0-9a-f]+)
		redir @commit https://quire.kejadlen.dev/{re.commit.1}/commits/{re.commit.2} permanent

		@log path_regexp log ^/alpha/([^/]+)/commits(/|$)
		redir @log https://quire.kejadlen.dev/{re.log.1}/log permanent

		@repo path_regexp repo ^/alpha/([^/]+?)(\.git)?(/|$)
		redir @repo https://quire.kejadlen.dev/{re.repo.1} permanent

		redir * https://quire.kejadlen.dev permanent
	}
}
