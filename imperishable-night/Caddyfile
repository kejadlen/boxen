{
	log default {
		output stdout
		format json
		include http.log.access tls
	}

	metrics

	servers {
		trusted_proxies static private_ranges @trusted_proxies@
		trusted_proxies_strict
	}

	tailscale {
		auth_key {env.TS_AUTHKEY}
		state_dir /data/tailscale
	}

	# The image has no certutil, and nothing in the container needs to trust the root.
	skip_install_trust

	# lotus-land-story's root, so devices that trust it trust these sites too.
	pki {
		ca local {
			root {
				format pem_file
				cert /etc/caddy/pki/root.crt
				key /etc/caddy/pki/root.key
			}
		}
	}
}

# Tailnet-bound sites: internal TLS, a dedicated tailscale node, and access
# logging routed to the default logger.
(ts) {
	tls internal
	bind tailscale/{args[0]}
	log
}

# Metrics only, for VictoriaMetrics.
authelia {
	import ts authelia
	handle /metrics {
		reverse_proxy authelia:9959
	}
	respond 404
}

books {
	import ts books
	tailscale_auth
	reverse_proxy calibre-web:8083 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}
}

homebox {
	import ts homebox
	reverse_proxy homebox:7745
}

docs {
	import ts docs
	tailscale_auth
	reverse_proxy paperless-ngx:8000 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}

	redir /flower /flower/
	handle /flower/* {
		reverse_proxy paperless-ngx:5555
	}
}

# Metrics only, for VictoriaMetrics; the public site 404s /metrics.
gotosocial {
	import ts gotosocial
	handle /metrics {
		reverse_proxy gotosocial:9464
	}
	respond 404
}

grafana {
	import ts grafana
	tailscale_auth
	reverse_proxy grafana:3000 {
		header_up X-Webauth-User {http.auth.user.tailscale_user}
	}
}

home-assistant-5119 {
	import ts home-assistant-5119
	reverse_proxy homeassistant-5119:8123
}

irc {
	import ts irc
	tailscale_auth

	root * /srv/gamja
	file_server
	reverse_proxy /socket soju:3030
}

ketchup {
	import ts ketchup
	tailscale_auth
	reverse_proxy ketchup:9292 {
		header_up Tailscale-User-Login {http.auth.user.tailscale_login}
		header_up Tailscale-User-Name {http.auth.user.tailscale_user}
	}
}

# Log shippers run on tagged nodes, which tailscale_auth would reject.
logs {
	import ts logs
	reverse_proxy victoria-logs:9428
}

# The scheme keeps Caddy from parsing metrics as the directive.
https://metrics {
	import ts metrics
	reverse_proxy victoria-metrics:8428
}

pihole {
	import ts pihole

	redir / /admin/
	reverse_proxy mountain-of-faith:80
}

quire {
	import ts quire
	tailscale_auth
	reverse_proxy quire:3000 {
		header_up Remote-User {http.auth.user.tailscale_login}
	}
}

rss {
	import ts rss

	# Outside tailscale_auth, which rejects tagged nodes like lotus-land-story's scraper.
	handle /metrics {
		reverse_proxy miniflux:8080 {
			header_up -Remote-User
		}
	}

	handle {
		tailscale_auth
		reverse_proxy miniflux:8080 {
			header_up Remote-User {http.auth.user.tailscale_login}
		}
	}
}

# Plain HTTP, since it hands out the root that a device needs before it trusts tls internal.
http://setup {
	bind tailscale/setup
	log
	file_server {
		root /srv/setup
	}
}

traces {
	import ts traces
	reverse_proxy victoria-traces:10428
}

# Tailnet-only; DNS-01 gets the publicly trusted certificate CardDAV clients need.
contacts.chislan.family {
	bind tailscale/pro-tacts
	log
	tls {
		dns dnsimple {env.DNSIMPLE_API_ACCESS_TOKEN}
	}
	tailscale_auth
	reverse_proxy pro-tacts:9292 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}
}

### Public

auth.kejadlen.dev, auth.chislan.family {
	log

	reverse_proxy authelia:9091
}

hey.kejadlen.dev {
	log

	reverse_proxy gotosocial:8080

	handle /metrics {
		respond 404
	}
}

quire.kejadlen.dev {
	# quire trusts Remote-User as proof of login.
	reverse_proxy quire:3000 {
		header_up -Remote-User
	}
}

git.kejadlen.dev {
	log

	# Maps gitea's URLs onto quire's. quire only shows the default branch,
	# so links to other branches, tags, and commits land on its tip.
	route {
		@file path_regexp file ^/alpha/([^/]+)/(src|raw)/(branch|tag|commit)/[^/]+/(.+)$
		redir @file https://quire.kejadlen.dev/{re.file.1}/tree/{re.file.4} permanent

		@commit path_regexp commit ^/alpha/([^/]+)/commit/([0-9a-f]+)
		redir @commit https://quire.kejadlen.dev/{re.commit.1}/commits/{re.commit.2} permanent

		@log path_regexp log ^/alpha/([^/]+)/commits(/|$)
		redir @log https://quire.kejadlen.dev/{re.log.1}/log permanent

		@repo path_regexp repo ^/alpha/([^/]+?)(\.git)?(/|$)
		redir @repo https://quire.kejadlen.dev/{re.repo.1} permanent

		redir * https://quire.kejadlen.dev permanent
	}
}

birbs.chislan.family {
	log

	# BirdNET-Pi answers every path with a page of relative links, an endless
	# URL space for crawlers.
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
"
	}

	reverse_proxy hopeless-masquerade:80
}

files.chislan.family {
	root /srv/files
	file_server
}

# synced from quire/gists
gists.kejadlen.dev {
	log

	root * /srv/gists
	encode zstd gzip

	# raw markdown, like GitHub's raw view
	@raw path *.md
	handle @raw {
		file_server
	}

	# rendered views; templates stays scoped here so raw .md is never evaluated
	handle {
		rewrite * /_render.html
		templates
		file_server
	}
}
