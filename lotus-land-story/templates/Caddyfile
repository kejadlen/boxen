{
	log default {
		output stdout
		format json
		include http.log.access tls
	}

	metrics

	servers {
		trusted_proxies static private_ranges {{ trusted_proxies }}
		trusted_proxies_strict
	}

	tailscale {
		auth_key {env.TS_AUTHKEY}
		state_dir /data/tailscale
	}
}

### Auth

# https://www.authelia.com/integration/proxies/caddy/#forwarded-header-trust#trusted-proxies
(trusted_proxy_list) {
	trusted_proxies {{ trusted_proxies }}
}

# Tailnet-bound sites: internal TLS, a dedicated tailscale node, and access
# logging routed to the default logger (shipped to VictoriaLogs via Vector).
# tsauth additionally gates on tailscale identity.
(ts) {
	tls internal
	bind tailscale/{args[0]}
	log
}

# Gates on tailscale identity; headers overwrite client-sent values. Apps
# can override Remote-User with header_up where they match another value.
(tsident) {
	tailscale_auth
	map {http.auth.user.tailscale_user} {ts_slug} {
{% for login, slug in (tailscale.slugs | from_yaml).items() %}
		{{ login }} {{ slug }}
{% endfor %}
		default {http.auth.user.tailscale_login}
	}
	request_header Remote-User {http.auth.user.tailscale_user}
	request_header X-User-Slug {ts_slug}
}

(tsauth) {
	import ts {args[0]}
	import tsident
}

{% for domain in ("kejadlen.dev", "chislan.family") %}
auth.{{ domain }} {
	log

	reverse_proxy authelia:9091 {
		import trusted_proxy_list
	}
}
{% endfor %}

http://setup {
	bind tailscale/setup
	log
	file_server {
		root /data/setup
	}
}

### Monitoring

cadvisor {
	import ts cadvisor
	reverse_proxy cadvisor:8080
}

grafana {
	import tsauth grafana
	reverse_proxy grafana:3000 {
		header_up X-Webauth-User {http.auth.user.tailscale_user}
	}
}

:2019 {
	metrics /metrics
}

logs {
	import ts logs
	reverse_proxy victoria-logs:9428
}

traces {
	import ts traces
	reverse_proxy victoria-traces:10428
}

# need scheme here since `metrics` is a directive
https://metrics {
	import ts metrics
	reverse_proxy victoria-metrics:8428
}

### Services

rss {
	import tsauth rss
	reverse_proxy miniflux:8080 {
		header_up Remote-User {http.auth.user.tailscale_login}
	}
}

docket {
	import tsauth docket
	reverse_proxy docket:3000
}

### Family

books {
	import tsauth books
	reverse_proxy calibre-web:8083 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}
}

contacts.chislan.family {
	bind tailscale/contacts
	log
	tls {
		dns dnsimple {env.DNSIMPLE_API_ACCESS_TOKEN}
	}
	import tsident

	reverse_proxy pro-tacts:9292 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}
}

