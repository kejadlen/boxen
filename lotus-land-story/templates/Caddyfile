{
	servers {
		metrics

		trusted_proxies static private_ranges {{ trusted_proxies }}
		trusted_proxies_strict
	}

	tailscale {
		auth_key {env.TS_AUTHKEY}
		state_dir /data/tailscale
	}
}

### Auth

# https://www.authelia.com/integration/proxies/caddy/#forwarded-header-trust#trusted-proxies
(trusted_proxy_list) {
	trusted_proxies {{ trusted_proxies }}
}

{% for domain in ("kejadlen.dev", "chislan.family") %}
auth.{{ domain }} {
	reverse_proxy authelia:9091 {
		import trusted_proxy_list
	}
}
{% endfor %}

http://setup {
	bind tailscale/setup
	file_server {
		root /data/setup
	}
}

### Monitoring

cadvisor {
	tls internal
	bind tailscale/cadvisor
	reverse_proxy cadvisor:8080
}

grafana {
	tls internal
	bind tailscale/grafana
	tailscale_auth
	reverse_proxy grafana:3000 {
		header_up X-Webauth-User {http.auth.user.tailscale_user}
	}
}

loki {
	tls internal
	bind tailscale/loki
	reverse_proxy loki:3100
}

:2019 {
	metrics /metrics
}

prometheus {
	tls internal
	bind tailscale/prometheus
	reverse_proxy prometheus:9090
}

### Services

rss {
	tls internal
	bind tailscale/rss
	tailscale_auth
	reverse_proxy miniflux:8080 {
		header_up Remote-User {http.auth.user.tailscale_login}
	}
}

search {
	tls internal
	bind tailscale/search
	reverse_proxy searxng:8080
}

search.kejadlen.dev {
	reverse_proxy searxng:8080
}

### Family

books {
	tls internal
	bind tailscale/books
	tailscale_auth
	reverse_proxy calibre-web:8083 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}
}

docs.chislan.family {
	forward_auth authelia:9091 {
		uri /api/verify?rd=https://auth.chislan.family
		copy_headers Remote-User

		# This import needs to be included if you're relying on a trusted proxies configuration.
		import trusted_proxy_list
	}

	reverse_proxy paperless-ngx:8000 {
		import trusted_proxy_list
	}

	redir /flower /flower/
	handle /flower/* {
		reverse_proxy paperless-ngx:5555
	}
}

docs {
	tls internal
	bind tailscale/docs
	tailscale_auth
	reverse_proxy paperless-ngx:8000 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}

	redir /flower /flower/
	handle /flower/* {
		reverse_proxy paperless-ngx:5555
	}
}

