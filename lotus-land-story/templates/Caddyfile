### External

# synced from quire/gists
gists.kejadlen.dev {
	log

	root * /data/gists
	encode zstd gzip

	# raw markdown, like GitHub's raw view
	@raw path *.md
	handle @raw {
		file_server
	}

	# rendered views; templates stays scoped here so raw .md is never evaluated
	handle {
		rewrite * /_render.html
		templates
		file_server
	}
}

birbs.chislan.family {
	log

	reverse_proxy hopeless-masquerade:80
}

files.chislan.family {
	root /data/files
	file_server
}

git.kejadlen.dev {
	log

	# Meta's web indexer hammers gitea's blame/diff endpoints hard enough
	# to spike load; throttle it to one request per minute per source IP.
	rate_limit {
		zone meta_webindexer {
			match {
				header User-Agent meta-webindexer/*
			}
			key {http.request.remote.host}
			events 1
			window 1m
			log_key
		}
	}

	# hacky way to reverse auth only from my laptop
	# remote_ip, not client_ip: any container can forge X-Forwarded-For.
	@undefined-fantastic-object remote_ip {{ undefined_fantastic_object_ip }}
	reverse_proxy @undefined-fantastic-object gitea:3000 {
		header_up X-Webauth-User alpha
	}

	# Gitea trusts X-Webauth-User from caddy, so never pass a client's through.
	reverse_proxy anubis:8923 {
		header_up X-Real-Ip {remote_host}
		header_up -X-Webauth-User
	}
}

