	}
}

docs {
	tls internal
	bind tailscale/docs
	tailscale_auth
	reverse_proxy paperless-ngx:8000 {
		header_up Remote-User {http.auth.user.tailscale_user}
	}

	redir /flower /flower/
	handle /flower/* {
		reverse_proxy paperless-ngx:5555
	}
}

