{
	log default {
		output stdout
		format json
		include http.log.access
	}

	metrics

	servers {
		trusted_proxies static private_ranges {{ trusted_proxies }}
		trusted_proxies_strict
	}

	tailscale {
		auth_key {env.TS_AUTHKEY}
		state_dir /data/tailscale
	}
}

### Auth

# https://www.authelia.com/integration/proxies/caddy/#forwarded-header-trust#trusted-proxies
(trusted_proxy_list) {
	trusted_proxies {{ trusted_proxies }}
}

{% for domain in ("kejadlen.dev", "chislan.family") %}
auth.{{ domain }} {
	log

	reverse_proxy authelia:9091 {
		import trusted_proxy_list
	}
}
{% endfor %}

http://setup {
	bind tailscale/setup
	file_server {
		root /data/setup
	}
}

### Monitoring

cadvisor {
	tls internal
	bind tailscale/cadvisor
	reverse_proxy cadvisor:8080
}

grafana {
	tls internal
	bind tailscale/grafana
	tailscale_auth
	reverse_proxy grafana:3000 {
		header_up X-Webauth-User {http.auth.user.tailscale_user}
	}
}

:2019 {
	metrics /metrics
}

logs {
	tls internal
	bind tailscale/logs
	reverse_proxy victoria-logs:9428
}

traces {
	tls internal
	bind tailscale/traces
	reverse_proxy victoria-traces:10428
}

# need scheme here since `metrics` is a directive
https://metrics {
 	tls internal
 	bind tailscale/metrics
 	reverse_proxy victoria-metrics:8428
}

### Services

quire {
	tls internal
	bind tailscale/quire
	tailscale_auth
	reverse_proxy quire:3000 {
		header_up Remote-User {http.auth.user.tailscale_login}
	}
}

irc {
	tls internal
	bind tailscale/irc
	tailscale_auth

	file_server
	root * /data/gamja/dist

	reverse_proxy /socket soju:3030
}

rss {
	tls internal
	bind tailscale/rss
	tailscale_auth
	reverse_proxy miniflux:8080 {
		header_up Remote-User {http.auth.user.tailscale_login}
	}
}

ketchup {
	tls internal
	bind tailscale/ketchup
	tailscale_auth
	reverse_proxy ketchup:9292 {
		header_up Tailscale-User-Login {http.auth.user.tailscale_login}
		header_up Tailscale-User-Name {http.auth.user.tailscale_user}
	}
}

### Family

books {
	tls internal
	bind tailscale/books
