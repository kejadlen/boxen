	redir / /admin/
	reverse_proxy mountain-of-faith:80
}

### External

# synced from quire/gists
gists.kejadlen.dev {
	log

	root * /data/gists
	encode zstd gzip

	# raw markdown, like GitHub's raw view
	@raw path *.md
	handle @raw {
		file_server
	}

	# rendered views; templates stays scoped here so raw .md is never evaluated
	handle {
		rewrite * /_render.html
		templates
		file_server
	}
}

birbs.chislan.family {
	log

	reverse_proxy hopeless-masquerade:80
}

files.chislan.family {
	root /data/files
	file_server
}

hey.kejadlen.dev {
	log

	reverse_proxy gotosocial:8080

	handle /metrics {
		respond 404
	}
}

